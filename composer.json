{
  "name": "cyclesoftware/buddy-plugin-cs-indexer",
  "description": "Plugin for indexing",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "Manticoresearch\\Buddy\\Plugin\\CsIndexer\\": "src/"
    }
  },
  "authors": [
    {
      "name": "CycleSoftware",
      "email": "info@cyclesoftware.nl"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "manticoresoftware/buddy-core": "0.1"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.8",
    "slevomat/coding-standard": "^8.5",
    "squizlabs/php_codesniffer": "^3.7",
    "phpunit/phpunit": "^9.5"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
